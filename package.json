{
  "name": "agentura",
  "displayName": "Agentura",
  "description": "%ext.description%",
  "version": "0.10.0",
  "private": true,
  "publisher": "fosteev",
  "repository": {
    "type": "git",
    "url": "https://github.com/fosteev/Agentura.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:agentura.chat",
    "onWebviewPanel:agentura.agentsGraph"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "codex:protocol": "node scripts/codex-protocol.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && vsce package",
    "test:integration": "npm run build && tsc -p test/integration/tsconfig.json && node test/integration/out/runTest.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentura",
          "title": "Agentura",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentura": [
        {
          "type": "webview",
          "id": "agentura.sidebar",
          "name": "Agentura"
        }
      ]
    },
    "commands": [
      {
        "command": "agentura.open",
        "title": "%command.open.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.newSession",
        "title": "%command.newSession.title%",
        "category": "Agentura",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon-dark.svg"
        }
      },
      {
        "command": "agentura.openLast",
        "title": "%command.openLast.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.resumeSession",
        "title": "%command.resumeSession.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.bindTask",
        "title": "%command.bindTask.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.unbindTask",
        "title": "%command.unbindTask.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.chatForTask",
        "title": "%command.chatForTask.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.jira.connect",
        "title": "%command.jira.connect.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.jira.disconnect",
        "title": "%command.jira.disconnect.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.jira.test",
        "title": "%command.jira.test.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.refreshUsage",
        "title": "%command.refreshUsage.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Agentura",
        "icon": "$(gear)"
      },
      {
        "command": "agentura.feedStyle",
        "title": "%command.feedStyle.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.composerLayout",
        "title": "%command.composerLayout.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.sidebarLimits",
        "title": "%command.sidebarLimits.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.taskSidebar",
        "title": "%command.taskSidebar.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.taskCard",
        "title": "%command.taskCard.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.taskTab",
        "title": "%command.taskTab.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.agentsView",
        "title": "%command.agentsView.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.gitLayout",
        "title": "%command.gitLayout.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.addGoogleFont",
        "title": "%command.addGoogleFont.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.showLogs",
        "title": "%command.showLogs.title%",
        "category": "Agentura"
      },
      {
        "command": "agentura.debug.showState",
        "title": "%command.debug.showState.title%",
        "category": "Agentura"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "agentura.bindTask",
          "when": "webviewId == 'agentura.sidebar' && webviewSection == 'session' && !sessionBound",
          "group": "task@1"
        },
        {
          "command": "agentura.unbindTask",
          "when": "webviewId == 'agentura.sidebar' && webviewSection == 'session' && sessionBound",
          "group": "task@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentura.debug.showState",
          "when": "agentura.debug"
        }
      ],
      "editor/title": [
        {
          "command": "agentura.newSession",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentura.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "agentura.newSession",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'agentura.chat' || focusedView == 'agentura.sidebar'"
      }
    ],
    "configuration": {
      "title": "Agentura",
      "properties": {
        "agentura.contextThresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            120000,
            150000
          ],
          "description": "%config.contextThresholds.description%"
        },
        "agentura.allowBypassPermissions": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "%config.allowBypassPermissions.description%"
        },
        "agentura.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "%config.defaultPermissionMode.enum.manual%",
            "%config.defaultPermissionMode.enum.acceptEdits%",
            "%config.defaultPermissionMode.enum.plan%",
            "%config.defaultPermissionMode.enum.bypassPermissions%"
          ],
          "default": "manual",
          "description": "%config.defaultPermissionMode.description%"
        },
        "agentura.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "%config.defaultEffort.enum.default%",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "%config.defaultEffort.description%"
        },
        "agentura.remoteControl": {
          "type": "boolean",
          "default": false,
          "description": "%config.remoteControl.description%"
        },
        "agentura.remoteControlNamePrefix": {
          "type": "string",
          "default": "",
          "description": "%config.remoteControlNamePrefix.description%"
        },
        "agentura.defaultModel": {
          "type": "string",
          "default": "",
          "description": "%config.defaultModel.description%"
        },
        "agentura.claudeExecutable": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "%config.claudeExecutable.description%"
        },
        "agentura.codexExecutable": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "%config.codexExecutable.description%"
        },
        "agentura.antigravityExecutable": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "%config.antigravityExecutable.description%"
        },
        "agentura.defaultProvider": {
          "type": "string",
          "scope": "application",
          "enum": [
            "claude",
            "codex",
            "antigravity"
          ],
          "enumDescriptions": [
            "Claude Code",
            "Codex",
            "Antigravity"
          ],
          "default": "claude",
          "description": "%config.defaultProvider.description%"
        },
        "agentura.usagePollMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 1440,
          "description": "%config.usagePollMinutes.description%"
        },
        "agentura.sessionList.view": {
          "type": "string",
          "enum": [
            "detailed",
            "compact",
            "dense"
          ],
          "enumDescriptions": [
            "%config.sessionList.view.enum.detailed%",
            "%config.sessionList.view.enum.compact%",
            "%config.sessionList.view.enum.dense%"
          ],
          "default": "compact",
          "description": "%config.sessionList.view.description%"
        },
        "agentura.sessionList.context": {
          "type": "boolean",
          "default": true,
          "description": "%config.sessionList.context.description%"
        },
        "agentura.sessionList.time": {
          "type": "boolean",
          "default": true,
          "description": "%config.sessionList.time.description%"
        },
        "agentura.sidebar.top": {
          "type": "string",
          "enum": [
            "detailed",
            "compact",
            "dense"
          ],
          "enumDescriptions": [
            "%config.sidebar.top.enum.detailed%",
            "%config.sidebar.top.enum.compact%",
            "%config.sidebar.top.enum.dense%"
          ],
          "default": "detailed",
          "description": "%config.sidebar.top.description%"
        },
        "agentura.sidebar.limits": {
          "type": "string",
          "enum": [
            "stack",
            "switch",
            "table",
            "active",
            "header"
          ],
          "enumDescriptions": [
            "%config.sidebar.limits.enum.stack%",
            "%config.sidebar.limits.enum.switch%",
            "%config.sidebar.limits.enum.table%",
            "%config.sidebar.limits.enum.active%",
            "%config.sidebar.limits.enum.header%"
          ],
          "default": "active",
          "description": "%config.sidebar.limits.description%"
        },
        "agentura.tasks.sidebar": {
          "type": "string",
          "enum": [
            "groups",
            "section"
          ],
          "enumDescriptions": [
            "%config.tasks.sidebar.enum.groups%",
            "%config.tasks.sidebar.enum.section%"
          ],
          "default": "groups",
          "description": "%config.tasks.sidebar.description%"
        },
        "agentura.tasks.card": {
          "type": "string",
          "enum": [
            "tab",
            "split"
          ],
          "enumDescriptions": [
            "%config.tasks.card.enum.tab%",
            "%config.tasks.card.enum.split%"
          ],
          "default": "tab",
          "description": "%config.tasks.card.description%"
        },
        "agentura.tasks.tab": {
          "type": "string",
          "enum": [
            "chat",
            "task"
          ],
          "enumDescriptions": [
            "%config.tasks.tab.enum.chat%",
            "%config.tasks.tab.enum.task%"
          ],
          "default": "chat",
          "description": "%config.tasks.tab.description%"
        },
        "agentura.feed.style": {
          "type": "string",
          "enum": [
            "journal",
            "folded",
            "replies",
            "cards"
          ],
          "enumDescriptions": [
            "%config.feed.style.enum.journal%",
            "%config.feed.style.enum.folded%",
            "%config.feed.style.enum.replies%",
            "%config.feed.style.enum.cards%"
          ],
          "default": "journal",
          "description": "%config.feed.style.description%"
        },
        "agentura.composer.layout": {
          "type": "string",
          "enum": [
            "classic",
            "card",
            "statusline",
            "gauges",
            "minimal",
            "shell"
          ],
          "enumDescriptions": [
            "%config.composer.layout.enum.classic%",
            "%config.composer.layout.enum.card%",
            "%config.composer.layout.enum.statusline%",
            "%config.composer.layout.enum.gauges%",
            "%config.composer.layout.enum.minimal%",
            "%config.composer.layout.enum.shell%"
          ],
          "default": "classic",
          "description": "%config.composer.layout.description%"
        },
        "agentura.agents.view": {
          "type": "string",
          "enum": [
            "list",
            "tree",
            "lanes",
            "cards",
            "graph"
          ],
          "enumDescriptions": [
            "%config.agents.view.enum.list%",
            "%config.agents.view.enum.tree%",
            "%config.agents.view.enum.lanes%",
            "%config.agents.view.enum.cards%",
            "%config.agents.view.enum.graph%"
          ],
          "default": "list",
          "description": "%config.agents.view.description%"
        },
        "agentura.git.layout": {
          "type": "string",
          "enum": [
            "stack",
            "picker",
            "unified"
          ],
          "enumDescriptions": [
            "%config.git.layout.enum.stack%",
            "%config.git.layout.enum.picker%",
            "%config.git.layout.enum.unified%"
          ],
          "default": "stack",
          "description": "%config.git.layout.description%"
        },
        "agentura.mcp.feedLabels": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcp.feedLabels.description%"
        },
        "agentura.mcp.composerButton": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcp.composerButton.description%"
        },
        "agentura.mcp.panelTab": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcp.panelTab.description%"
        },
        "agentura.mcp.feedStatus": {
          "type": "string",
          "enum": [
            "failures",
            "start",
            "off"
          ],
          "enumDescriptions": [
            "%config.mcp.feedStatus.enum.failures%",
            "%config.mcp.feedStatus.enum.start%",
            "%config.mcp.feedStatus.enum.off%"
          ],
          "default": "failures",
          "description": "%config.mcp.feedStatus.description%"
        },
        "agentura.font.interface": {
          "type": "string",
          "default": "",
          "description": "%config.font.interface.description%"
        },
        "agentura.font.panels": {
          "type": "string",
          "default": "",
          "description": "%config.font.panels.description%"
        },
        "agentura.font.code": {
          "type": "string",
          "default": "",
          "description": "%config.font.code.description%"
        },
        "agentura.feed.fontSize": {
          "type": "integer",
          "default": 13,
          "minimum": 10,
          "maximum": 20,
          "description": "%config.feed.fontSize.description%"
        },
        "agentura.ui.fontSize": {
          "type": "integer",
          "default": 13,
          "minimum": 10,
          "maximum": 20,
          "description": "%config.ui.fontSize.description%"
        },
        "agentura.language": {
          "type": "string",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.ru%",
            "English"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "agentura.limits.readKeychain": {
          "type": "boolean",
          "default": true,
          "description": "%config.limits.readKeychain.description%"
        },
        "agentura.jira.source": {
          "type": "string",
          "enum": [
            "auto",
            "jiraffe",
            "own",
            "off"
          ],
          "enumDescriptions": [
            "%config.jira.source.enum.auto%",
            "%config.jira.source.enum.jiraffe%",
            "%config.jira.source.enum.own%",
            "%config.jira.source.enum.off%"
          ],
          "default": "auto",
          "description": "%config.jira.source.description%"
        },
        "agentura.tasks.refresh": {
          "type": "string",
          "enum": [
            "30s",
            "manual"
          ],
          "enumDescriptions": [
            "%config.tasks.refresh.enum.30s%",
            "%config.tasks.refresh.enum.manual%"
          ],
          "default": "30s",
          "description": "%config.tasks.refresh.description%"
        },
        "agentura.tasks.humanChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.tasks.humanChanges.description%"
        },
        "agentura.jira.agentTools": {
          "type": "object",
          "default": {
            "comment": true,
            "transition": true,
            "worklog": true
          },
          "properties": {
            "comment": {
              "type": "boolean",
              "default": true,
              "description": "%config.jira.agentTools.comment%"
            },
            "transition": {
              "type": "boolean",
              "default": true,
              "description": "%config.jira.agentTools.transition%"
            },
            "worklog": {
              "type": "boolean",
              "default": true,
              "description": "%config.jira.agentTools.worklog%"
            }
          },
          "additionalProperties": false,
          "description": "%config.jira.agentTools.description%"
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@anthropic-ai/sdk": "^0.130.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/signals": "^2.11.3",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "preact": "^11.0.0",
    "prettier": "^3.9.9",
    "qrcode-generator": "^2.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "icon": "media/icon.png"
}
